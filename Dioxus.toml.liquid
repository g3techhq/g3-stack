[application]
name = "{{ project-name }}"
asset_dir = "assets"
default_platform = "web"
out_dir = "dist"

tailwind_input = "tailwind.css"
tailwind_output = "assets/tailwind.css"

[web]
# Release builds write a brotli copy of every asset and the wasm next to it,
# which the server sends to browsers that accept it. Quality 11 at build time
# is smaller than a proxy compressing on the fly, and needs no proxy at all.
pre_compress = true

[web.app]
title = "{{ project-name | title_case }}"

[web.watcher]
reload_html = true
watch_path = ["src", "assets"]

# No `[web.resource] style` entry for the stylesheet. That writes a bare
# `<link>` to a path `dx bundle` never copies, so a deployed build requests a
# file that is not there. `asset!()` in src/app.rs links the real, hashed one.

[bundle]
identifier = "{% if bundle_id != "" %}{{ bundle_id }}{% else %}com.example.{{ project-name | remove: "-" }}{% endif %}"
publisher = "Example"
# The full-bleed master; dx renders the Android launcher icons from it. iOS
# uses `[ios] icon`, and assets/icon/icon-512.png is the Play listing icon.
icon = ["assets/icon/icon.svg"]
category = "Productivity"
short_description = "An app built on the g3 stack."
long_description = "A starter application built with Dioxus, SurrealDB, g3-ui, g3-native-plugins, and g3-route-transitions."

# Universal links / App Links: off until you own a domain for them. Left on
# with a placeholder, every generated app declared `app.example.com` in its
# associated-domains entitlement and Android intent filters. To turn them on,
# uncomment the table, put your own domain in `hosts`, serve the association
# files from it, and enable g3-native-plugins' `deep-links` feature. The paths
# are the ones the OS hands to the app instead of the browser. See
# docs/mobile.md, "Deep links".
# [deep_links]
# hosts = ["app.example.com"]
# paths = ["/notes/*"]

[ios]
# Opaque, with no alpha channel: App Store Connect rejects one that has it.
# `npm run icon -- assets/icon/icon.svg` renders it from the master.
icon = ["assets/icon/icon-1024.png"]
# iOS 17.5. Older WKWebViews lack light-dark(), which g3-ui's theme colors
# need, as Android's min_sdk below does for Chromium 123.
deployment_target = "17.5"

[ios.plist]
# Phones stay in portrait: g3-ui picks its layout by width, so a phone
# turned sideways got the tablet layout with little height left for content.
# iPads keep dx's default and rotate. Needs dx from the Gateway3B fork
# ("g3: let an app declare its own orientations"), or the key is written twice.
UISupportedInterfaceOrientations = ["UIInterfaceOrientationPortrait"]
# Answers App Store Connect's export-compliance question on every upload.
# `false` is right while the app only uses HTTPS and the OS's own encryption;
# change it if you add encryption of your own.
ITSAppUsesNonExemptEncryption = false

[android]
# Android 8.0. Older versions stopped getting WebView updates before
# Chromium 123, which g3-ui's light-dark() theme colors need.
min_sdk = 26
target_sdk = 36
compile_sdk = 36
# Phones stay in portrait; tablets rotate. See the file.
manifest = "android/AndroidManifest.xml"
