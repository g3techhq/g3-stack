# Copy to `.env` and adjust. `.env` is gitignored; this file is not.
# Only the server reads these, and only debug builds read this file. A release
# build reads the real environment (see docs/deployment.md).

# --- SurrealDB ------------------------------------------------------------
# Matches the `db` service in compose.yml.
SURREALDB_HOST=ws://localhost:8000
SURREALDB_USER=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE={{ project-name }}
SURREALDB_NAME=development

# The host port compose.yml publishes SurrealDB on. If 8000 is taken (another
# project's database, say), change this and the port in SURREALDB_HOST together.
SURREALDB_PORT=8000

# --- Mobile builds only ---------------------------------------------------
# Web builds call the origin that served them and ignore this. A mobile app has
# no origin, so its server is compiled in from SERVER_URL at build time. Leave it
# unset during `dx serve --platform android|ios`, which points the app at your
# machine by itself. Release builds require an HTTPS origin.
# See docs/mobile.md.
# SERVER_URL=https://app.example.com

# --- Optional OAuth providers ---------------------------------------------
# The template ships guest sign-in only. If you add Google or Apple sign-in,
# these public identifiers are needed by both sides of a fullstack web build:
# the browser reads them at compile time and the server reads them at runtime.
# A value in this dotenv file configures the debug server, but option_env! does
# not read dotenv; export the same values in the shell that runs dx build.
# GOOGLE_OAUTH_CLIENT_ID=123456789-example.apps.googleusercontent.com
# APPLE_SERVICES_ID=com.example.web
