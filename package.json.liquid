{
  "name": "{{ project-name }}-tooling",
  "private": true,
  "version": "0.1.0",
  "description": "Formatting, linting, and browser test tooling for the g3 stack app",
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:mobile": "playwright test --project mobile-chromium",
    "test:ui:desktop": "playwright test --project desktop-chromium",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "format:web": "biome format --write .",
    "format:web:check": "biome format .",
    "lint:web": "biome lint .",
    "test:scripts": "node --test scripts/*.test.mjs",
    "rename": "node scripts/rename.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.56.1"
  }
}
